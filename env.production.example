# Server par is file ko ".env" naam se save karo (cp .env.production.example .env)
# aur dono values badal do. Is file ko kabhi GitHub par mat daalo.

# Lamba random secret, e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=yahan-lamba-random-secret-likho

DB_PORT=3306
DB_USER=root
DB_PASSWORD=yahan-mazboot-password-likho
DB_NAME=na_pp_db
DB_CONNECT_TIMEOUT=10

MAX_UPLOAD_MB=50

# HTTP par chalane ke liye 0. HTTPS lagane ke baad 1 kar dena.
SESSION_COOKIE_SECURE=0
