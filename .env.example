# Copy this file to .env for local use.
# Never commit the real .env file to GitHub.

SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=1
FLASK_HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_MB=50

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=na_pp_db
DB_CONNECT_TIMEOUT=10

# Logins are stored (hashed) in the MySQL `users` table.
# Create the first admin with:  python create_admin.py
# Set SESSION_COOKIE_SECURE=1 when serving over HTTPS.
SESSION_COOKIE_SECURE=0
